# Preferred: paste a console/sandbox key.
# If empty and OPENGONG_AUTO_MINT_SANDBOX=true, first run mints pyai_test_ via POST /v1/sandbox/keys
PYAI_API_KEY=
PYAI_BASE_URL=https://api.pyai.com/v1

# Hear
# pyai-hear is used for mono diarization (Sortformer). Telephony is used for stereo channel split.
PYAI_HEAR_MODEL=pyai-hear
PYAI_HEAR_JOB_MODEL=pyai-hear-telephony
OPENGONG_DIARIZE=true
# Set true only for dual-channel stereo telephony. Do not combine with diarize.
OPENGONG_CHANNEL=false

# Recap (needs org Recap add-on + recap:read / recap:configure)
PYAI_RECAP_PACK_ID=sales_outbound

# Optional fallback when Recap is unavailable (OpenAI-compatible chat API)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Harness / bootstrap
OPENGONG_MAX_ATTEMPTS=3
OPENGONG_DEADLINE_MS=180000
OPENGONG_MAX_TOKENS=8000
OPENGONG_DEMO_WITHOUT_KEY=true
# On Railway: set false and provide PYAI_API_KEY (ephemeral disk loses minted keys)
OPENGONG_AUTO_MINT_SANDBOX=true

# Paths (Railway Dockerfile defaults OPENGONG_DATA_DIR=/app/data)
# OPENGONG_DATA_DIR=./data
# OPENGONG_SAMPLE_DIR=./sample-calls

# Login (optional). When OPENGONG_AUTH_PASSWORD is set, /login is required.
# Share links (/share/…) stay public. Leave password empty to disable auth.
OPENGONG_AUTH_USER=demo
OPENGONG_AUTH_PASSWORD=
OPENGONG_SESSION_SECRET=
# Shown on the login form (safe for hackathon demos; leave empty in prod)
OPENGONG_AUTH_HINT=

# Railway / Docker listen (standalone server respects these)
# PORT=3000
# HOSTNAME=0.0.0.0
