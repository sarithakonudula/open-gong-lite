# Preferred: paste a console/sandbox key.
# If empty and OPENGONG_AUTO_MINT_SANDBOX=true, first run mints pyai_test_ via POST /v1/sandbox/keys
PYAI_API_KEY=
PYAI_BASE_URL=https://api.pyai.com/v1

# Hear
PYAI_HEAR_MODEL=pyai-hear
PYAI_HEAR_JOB_MODEL=pyai-hear-telephony
OPENGONG_DIARIZE=true
# Set true for stereo telephony (exact channel speakers)
OPENGONG_CHANNEL=false

# Recap (needs org Recap add-on + recap:read / recap:configure)
PYAI_RECAP_PACK_ID=sales_outbound

# Optional fallback when Recap is unavailable (OpenAI-compatible chat API)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Harness / bootstrap
OPENGONG_MAX_ATTEMPTS=3
OPENGONG_DEADLINE_MS=180000
OPENGONG_MAX_TOKENS=8000
OPENGONG_DEMO_WITHOUT_KEY=true
OPENGONG_AUTO_MINT_SANDBOX=true
